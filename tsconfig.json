{
  "compilerOptions": {
    "module": "es6",
    "target": "es6",
    "lib": ["es6", "dom"],
    "allowJs": true,
    "jsx": "react",
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
  },
  "files":["src/main.ts"],
}